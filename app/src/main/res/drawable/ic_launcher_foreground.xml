<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:pivotX="54" android:pivotY="54">
        <!-- Outer Glowing Accent & Drop Ring for the Square Terminal -->
        <path
            android:pathData="M28,24 h52 a10,10 0 0 1 10,10 v52 a10,10 0 0 1 -10,10 h-52 a10,10 0 0 1 -10,-10 v-52 a10,10 0 0 1 10,-10 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24"
                    android:startY="20"
                    android:endX="84"
                    android:endY="92"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#3300F0FF" />
                    <item android:offset="1.0" android:color="#2200F0FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Square Terminal Container -->
        <path
            android:pathData="M30,26 h48 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-48 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="30"
                    android:startY="26"
                    android:endX="78"
                    android:endY="82"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#0F1B2B" />
                    <item android:offset="1.0" android:color="#060A10" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Cyber Border for Square Window -->
        <path
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M30,26 h48 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-48 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="22"
                    android:startY="26"
                    android:endX="86"
                    android:endY="82"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00F0FF" />
                    <item android:offset="0.6" android:color="#00B8FF" />
                    <item android:offset="1.0" android:color="#00F0FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Top Title Bar Line Divider -->
        <path
            android:strokeColor="#1E334D"
            android:strokeWidth="1.2"
            android:pathData="M22,38 L86,38" />

        <!-- 3 Terminal Header Dots -->
        <path
            android:pathData="M30,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
            android:fillColor="#FF5555" />
        <path
            android:pathData="M36.5,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
            android:fillColor="#FFB800" />
        <path
            android:pathData="M43,32m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
            android:fillColor="#00F0FF" />

        <!-- Terminal Command Prompt '>' Neon Cyan -->
        <path
            android:strokeColor="#00F0FF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M37,49 L47,57 L37,65" />

        <!-- Terminal Blinking Cursor '_' Neon Cyan -->
        <path
            android:strokeColor="#00F0FF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M52,65 L66,65" />

        <!-- Energy Sparks / Corner Dots -->
        <path
            android:pathData="M73,47m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0"
            android:fillColor="#00F0FF" />
        <path
            android:pathData="M78,52m-1.2,0a1.2,1.2 0 1,1 2.4,0a1.2,1.2 0 1,1 -2.4,0"
            android:fillColor="#00F0FF" />
    </group>
</vector>

